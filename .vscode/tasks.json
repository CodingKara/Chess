{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Chess (x64 Release)",
            "type": "process",
            "command": "${env:ProgramFiles}\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "${workspaceFolder}\\Chess.sln",
                "/m",
                "/p:Configuration=Release",
                "/p:Platform=x64",
                "/verbosity:minimal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
